# Contact form (Resend). Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Optional. Without a verified domain in Resend, keep the default sender and send to the
# email that owns the Resend account (onboarding@resend.dev only delivers there).
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# Must be the email that owns the Resend account while the sender is onboarding@resend.dev.
CONTACT_TO_EMAIL=
